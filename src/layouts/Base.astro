---
import '../styles/global.css';
import { NOMBRE_ROL } from '../servidor/paginas';

interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
const actor = Astro.locals.actor;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Olimpiadas Evangélicas</title>
  </head>
  <body class="mx-auto max-w-2xl px-4 py-6">
    <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 pb-4">
      <a href="/" class="text-xl font-bold tracking-tight">Olimpiadas Evangélicas</a>
      {actor && (
        <div class="flex items-center gap-3 text-sm">
          <span class="text-slate-700">
            {actor.nombre} · <span class="text-slate-500">{NOMBRE_ROL[actor.rol]}</span>
          </span>
          <form method="post" action="/salir">
            <button class="boton-secundario">Salir</button>
          </form>
        </div>
      )}
    </header>

    <main class="mt-6 space-y-6">
      <slot />
    </main>
  </body>
</html>
