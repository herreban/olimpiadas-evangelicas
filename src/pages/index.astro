---
import Base from '../layouts/Base.astro';
import CalculadoraCategoria from '../components/CalculadoraCategoria';
import { bd } from '../db/conexion';
import { miIglesia } from '../servidor/cuentas';

// El middleware ya ha mandado a /entrar a quien no ha entrado.
const actor = Astro.locals.actor!;
const iglesia = await miIglesia(bd(), actor);
const anioEdicion = new Date().getFullYear();
---

<Base titulo="Inicio">
  <section>
    <h1 class="text-2xl font-bold">{iglesia ? iglesia.nombre : 'Plataforma'}</h1>
    {iglesia && <p class="text-slate-600">{iglesia.ciudad}</p>}
  </section>

  {actor.rol === 'plataforma' && (
    <a href="/plataforma" class="tarjeta block hover:bg-slate-50">
      <h2 class="text-lg font-semibold">Iglesias y enlaces →</h2>
      <p class="text-sm text-slate-600">Dar de alta iglesias y ayudar con las contraseñas.</p>
    </a>
  )}

  {actor.rol === 'admin_iglesia' && (
    <a href="/iglesia/usuarios" class="tarjeta block hover:bg-slate-50">
      <h2 class="text-lg font-semibold">Usuarios de la iglesia →</h2>
      <p class="text-sm text-slate-600">Invitar voluntarios y administradores, y dar enlaces de contraseña nueva.</p>
    </a>
  )}

  <CalculadoraCategoria client:load anioEdicion={anioEdicion} />

  <section class="tarjeta">
    <h2 class="text-base font-semibold">Cómo va el proyecto</h2>
    <p class="mt-1 text-sm text-slate-600">
      Fase 1: cuentas, iglesias y papeles. Los participantes, las ediciones y las pruebas llegan en la fase 2.
    </p>
  </section>
</Base>
