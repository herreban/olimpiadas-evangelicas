---
import Base from '../layouts/Base.astro';
import { bd } from '../db/conexion';
import { auth } from '../servidor/auth';
import { campo, ipDe } from '../servidor/paginas';
import { entrar } from '../servidor/sesion';

if (Astro.locals.actor) return Astro.redirect('/');

let error = '';
let usuario = '';

if (Astro.request.method === 'POST') {
  const formulario = await Astro.request.formData();
  usuario = campo(formulario, 'usuario');
  const resultado = await entrar(auth(), bd(), {
    usuario,
    contrasena: campo(formulario, 'contrasena'),
    ip: ipDe(Astro.request, Astro.clientAddress),
    cabeceras: Astro.request.headers,
  });

  if (resultado.ok) {
    const cabeceras = new Headers({ location: '/' });
    for (const cookie of resultado.cabeceras.getSetCookie()) cabeceras.append('set-cookie', cookie);
    return new Response(null, { status: 303, headers: cabeceras });
  }
  error = resultado.mensaje;
  Astro.response.status = 401;
}
---

<Base titulo="Entrar">
  <section class="tarjeta">
    <h1 class="text-2xl font-bold">Entrar</h1>
    <p class="mt-1 text-sm text-slate-600">
      ¿No tienes cuenta? Pide un enlace de invitación al administrador de tu iglesia.
    </p>

    {error && <p class="aviso-error mt-4" role="alert">{error}</p>}

    <form method="post" class="mt-4 space-y-4">
      <label class="etiqueta">
        Usuario
        <input name="usuario" value={usuario} required autocomplete="username" autocapitalize="none" spellcheck="false" class="entrada" />
      </label>
      <label class="etiqueta">
        Contraseña
        <input name="contrasena" type="password" required autocomplete="current-password" class="entrada" />
      </label>
      <button class="boton w-full">Entrar</button>
    </form>

    <p class="mt-4 text-sm text-slate-600">
      ¿Has olvidado la contraseña? Pide al administrador de tu iglesia un enlace para cambiarla.
    </p>
  </section>
</Base>
