# Copia este fichero como .env y rellénalo. El .env NUNCA se sube al repositorio.

# Dirección de la base de datos PostgreSQL.
DATABASE_URL=postgres://olimpiadas:CONTRASEÑA@localhost:5432/olimpiadas

# Secreto para firmar las sesiones: al menos 32 caracteres aleatorios.
# Se puede generar con:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Dirección pública de la web (con https en producción). Con ella se montan los enlaces de
# invitación y se marca la cookie de sesión como segura.
BETTER_AUTH_URL=http://localhost:4321

# Solo para las pruebas automáticas: una base de datos que se puede vaciar sin miedo.
# DATABASE_URL_PRUEBAS=postgres://postgres@localhost:5432/olimpiadas_pruebas
